{
  "manifest_version": 3,
  "name": "ELH Tim's helper",
  "version": "0.4",
  "description": "Helps to work on Erasmus Life Housing platform",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
    ,
    {
      "matches": ["https://www.uniplaces.com/accommodation/*"],
      "js": ["parser_uniplaces.js"]
    },
    {
      "matches": ["https://www.erasmuslifehousing.com/*"],
      "js": ["pasteJsonFields.js"]
    }
  ],
  "icons": {
    "128": "icon/icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
