{
  "manifest_version": 3,
  "name": "ELH Tim's helper",
  "version": "0.6",
  "description": "Adds some buttons to help working with Erasmus Life Housing platform",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "tabGroups",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.erasmuslifehousing.com/*",
    "https://www.uniplaces.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.erasmuslifehousing.com/*"],
      "js": [
        "src/content/content.js"
      ]
    },
    {
      "matches": ["https://www.erasmuslifehousing.com/dashboard/admin/houses"],
      "js": [
        "src/content/openTabs/openTabsOfListing.js"
      ]
    },
    {
      "matches": ["https://www.erasmuslifehousing.com/dashboard/admin/listings"],
      "js": [
        "src/content/openTabs/openTabsFromAllListings.js"
      ]
    },
    {
      "matches": ["https://www.uniplaces.com/accommodation/*"],
      "js": [
        "src/content/parser/parser_uniplaces.common.js",
        "src/content/parser/parser_uniplaces.data.js",
        "src/content/parser/parser_uniplaces.images.js"
      ]
    },
    {
      "matches": ["https://www.erasmuslifehousing.com/*"],
      "js": [
        "src/content/pasteJson/pasteFlatJsonFields.js",
        "src/content/pasteJson/pasteRoomJsonFields.js"
      ]
    }
  ],
  "icons": {
    "128": "icon/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/buttons.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}