{
  "manifest_version": 3,
  "name": "ELH Tim's helper",
  "version": "0.1",
  "description": "Helps to work on Erasmus Life Housing platform",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "icon/icon.png"
  }
}
